# ============================================================
# .env.local.example — Dùng với docker-compose.local.yml
# Copy file này thành .env.local và điền giá trị thật
# ============================================================

# 🔐 JWT & Security (copy từ .env của BE)
PRIVATE_ACCESS_TOKEN_KEY=your_access_token_private_key_here
PRIVATE_REFRESH_TOKEN_KEY=your_refresh_token_private_key_here
ALGORITHM_JWT=HS256
ACCESS_TOKEN_EXPIRATION_TIME=1h
REFRESH_TOKEN_EXPIRATION_TIME=3d
SECRET_OR_PUBLIC_JWT_KEY=your_jwt_secret_key_here
PRIVATE_PASSWORD=your_strong_private_password_here
PASSWORD_SECRET=your_password_secret_here

# 📧 Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# 🔵 Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 🤖 reCAPTCHA
SECRECT_KEY_RECAPCHA=your_recaptcha_secret_key
VITE_SITE_KEY_CAPCHA=your_recaptcha_site_key
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_CLIENT_SECRET=your_google_client_secret

# 🚦 Rate Limiting (optional)
COMMON_RATE_LIMIT_WINDOW_MS=1000
COMMON_RATE_LIMIT_MAX_REQUESTS=100
